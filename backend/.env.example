# ===== DeepSeek API =====
# 注意：原 key 已在对话里暴露，请到 platform.deepseek.com 删除重建后填这里
DEEPSEEK_API_KEY=sk-your-rotated-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型分工：flash 扮演客户（快），pro 评分（准），vision 后期识图
MODEL_CUSTOMER=deepseek-v4-flash
MODEL_SCORER=deepseek-v4-pro
MODEL_VISION=deepseek-v4-flash-vision-exp

# ===== 数据库 =====
# MVP 用 SQLite，零安装；切 MySQL 改成：mysql+asyncmy://user:pwd@localhost:3306/drill_system
DATABASE_URL=sqlite+aiosqlite:///./drill.db

# ===== Redis（MVP 可不开） =====
REDIS_URL=redis://localhost:6379/0

# ===== JWT =====
JWT_SECRET=please-change-this-to-a-random-32-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ===== 应用 =====
APP_ENV=dev
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
